# Example of /etc/local-secrets — copy to the device, fill in real values,
# chmod 600. NEVER commit the real file (it is git-ignored). This is preserved
# across sysupgrade because it is listed in /etc/sysupgrade.conf.
#
# Scripts source it with:  . /etc/local-secrets
#
# Keep an OFF-DEVICE copy of BACKUP_PASSPHRASE (password manager). Without it
# the encrypted backups cannot be decrypted — i.e. they are useless exactly
# when you need them.

# --- MinIO / S3 daily backup target ---
S3_ENDPOINT="http://s3.homelab"
S3_BUCKET="router-backups"
S3_KEY="your-write-key"
S3_SECRET="your-write-secret"

# --- Client-side backup encryption ---
# Generate: head -c 32 /dev/urandom | sha256sum | cut -d' ' -f1
BACKUP_PASSPHRASE="generate-a-strong-one"

# --- Other credentials to consolidate here over time ---
# (replaces the inline placeholders in common/08 and home-router/06,08)
# LOKI_AUTH_USERNAME="..."
# LOKI_AUTH_PASSWORD="..."
# ADGUARD_USER="admin"
# ADGUARD_PASS="..."
# ADGUARD_BCRYPT_HASH="..."
# ROUTER_HOSTNAME="..."
# WOL_HOST_IP="172.16.1.220"
# WOL_HOST_MAC="58:11:22:b0:a6:af"
